# ============================================================
# 通用变量配置 - main_server_monitor.py
# 本文件与 main_server_monitor.py 同目录，KEY=VALUE 格式
# 修改后重启 main_server_monitor.py 生效
# ============================================================

# GPU 采集脚本目录（各厂商脚本所在根目录）
GPU_INFO_DIR=/opt/gpu_info

# 采集上报间隔（秒）
INTERVAL_SECONDS=30

# 上报方式:
#   http    -> 通过 HTTP POST JSON 上报到 REPORT_URL
#   local   -> 仅写本地日志（不上报，调试用）
REPORT_MODE=http

# HTTP 上报地址（REPORT_MODE=http 时生效）
# 服务端需接收 POST /api/gpu/report，body 为 JSON:
#   {"hostname":..., "ip":..., "machine_type":..., "gpu_vendor":..., "gpu_model":..., "gpu_count":..., "timestamp":..., "gpus":[...]}
REPORT_URL=http://127.0.0.1:8099/api/gpu/report

# 上报鉴权 token（可选，为空则不携带）
REPORT_TOKEN=

# 日志目录与文件
LOG_DIR=/var/log/gpu-monitor
LOG_FILE=gpu_monitor.log

# 是否强制运行（0=仅物理机+GPU 机器才采集; 1=忽略机器类型检测，直接采集）
FORCE_RUN=0

# 采集超时（秒，单次 vendor 脚本执行超时）
SCRIPT_TIMEOUT=30

# 可选：手动指定上报 IP。留空时根据 REPORT_URL 的路由自动推导本机出口 IP。
HOST_IP=

# 是否输出设备唯一标识。默认关闭，避免在日志/上报数据中暴露 SN、UUID、unique_id。
# 如确实需要做资产级定位，可设置为 1。
ENABLE_DEVICE_ID=0
